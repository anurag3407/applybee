# Apply Bee — environment configuration.
# Names and descriptions only. Obtain real values from provider dashboards.
# Never commit real credentials.

# --- Application ---
# development | staging | production
APP_ENV=development
# Canonical base URL used to construct OAuth callbacks and receipt links.
APP_BASE_URL=http://localhost:3000
# Public canonical website URL (marketing metadata only).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL / Neon) ---
# Runtime role with least privilege in production.
DATABASE_URL=postgresql://localhost:5432/applybee_dev
# Privileged migration role, CI/migration job only.
DATABASE_MIGRATION_URL=postgresql://localhost:5432/applybee_dev

# --- Authentication ---
# When Clerk keys are present the Clerk adapter is used. Without them the app
# falls back to the labeled local development session adapter (never for production).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Rate limit / cache (Upstash Redis, optional) ---
# Without these, durable Postgres-backed quota admission is the limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Gmail (separate OAuth project from social login) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/gmail/callback

# --- Token encryption (AES-256-GCM envelope) ---
TOKEN_ENCRYPTION_KEY_VERSION=1
# 32-byte base64 key. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
# Available, evaluated model ID — never an invented model name.
GEMINI_MODEL_ID=
AI_PROMPT_VERSION=2026-10-04.1
AI_DAILY_COST_BUDGET_INR=500

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# test | live — mismatch with deployment blocks activation.
PAYMENTS_MODE=test

# --- Object storage (Resumes & Candidate Files) ---
# Priority when multiple are set: Cloudflare R2 > Appwrite > Supabase > Neon
# Currently defaulted to Neon (uses your existing DATABASE_URL, zero extra services/keys!)
IS_NEON=true
IS_NEON_DB=true
OBJECT_STORE_PROVIDER=neon

# Cloudflare R2 (Priority 1 — activated when CLOUDFLARE_R2=true)
CLOUDFLARE_R2=false
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=resumes

# Appwrite Cloud Storage (Priority 2 — 2 GB Free, no credit card)
APPWRITE_STORAGE=false
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_BUCKET_ID=resumes

# Supabase Storage (Priority 3 — 1 GB Free, no credit card)
SUPABASE_STORAGE=false
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=resumes

# --- Document processor (isolated scan/parse service) ---
DOCUMENT_PROCESSOR_ENDPOINT=
DOCUMENT_PROCESSOR_SIGNING_SECRET=

# --- Observability ---
SENTRY_DSN=

# --- Transactional email (product notifications only, never outreach) ---
TRANSACTIONAL_EMAIL_FROM=

# --- Feature flags (kill switches / launch gates) ---
FEATURE_AI_ENABLED=true
FEATURE_GMAIL_ENABLED=true
FEATURE_LIVE_PURCHASES_ENABLED=false
FEATURE_RESUME_ATTACHMENTS_ENABLED=true
