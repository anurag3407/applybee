{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "applybee",
	"compatibility_date": "2026-10-04",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "applybee"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	// Public configuration only. Secrets belong in `wrangler secret put <NAME>`,
	// never in this file.
	//
	// REQUIRED SECRETS (set with `wrangler secret put <NAME>`):
	//   CLERK_SECRET_KEY
	//   CLERK_WEBHOOK_SIGNING_SECRET
	//   DATABASE_URL
	//   TOKEN_ENCRYPTION_KEY
	//   GOOGLE_OAUTH_CLIENT_ID
	//   GOOGLE_OAUTH_CLIENT_SECRET
	//   GOOGLE_OAUTH_REDIRECT_URI
	//   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET
	//   RESEND_API_KEY
	//   CRON_SECRET
	//
	// src/server/config.ts refuses to boot when any of these are missing in
	// production, so a half-configured deploy fails loudly instead of serving a
	// silently broken site.
	"vars": {
		"APP_ENV": "production",
		"APP_BASE_URL": "https://reachbee.sayalabs.in",
		"NEXT_PUBLIC_APP_URL": "https://reachbee.sayalabs.in",
		// The worker answers on both custom domains; both must be able to make
		// cookie-authenticated mutations or users get FORBIDDEN_ORIGIN.
		"EXTRA_ALLOWED_ORIGINS": "https://applybee.sayalabs.in,https://reachbee.sayalabs.in",
		"NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_d2lyZWQtbGFkeWJ1Zy0xMDg2LmNsZXJrLmFjY291bnRzLmRldiQ",
		"NEXT_PUBLIC_RAZORPAY_KEY_ID": "rzp_test_TRKmHVGDmSWHr3",
		// UTC hour at which /api/v1/cron/run sends the daily digest.
		"CRON_DIGEST_HOUR_UTC": "6"
	},
	"routes": [
		{
			"pattern": "applybee.sayalabs.in",
			"custom_domain": true
		},
		{
			"pattern": "reachbee.sayalabs.in",
			"custom_domain": true
		}
	]
}